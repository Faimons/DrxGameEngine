"""
API Documentation Database
Stores and retrieves engine API documentation
"""

import json
import logging
from pathlib import Path
from typing import List, Dict, Any, Optional
from dataclasses import dataclass


@dataclass
class APIEntry:
    name: str
    namespace: str
    description: str
    usage: str
    parameters: List[Dict[str, str]]
    return_type: str
    example: str
    category: str


class APIDatabase:
    """
    Database of engine API documentation
    """
    
    def __init__(self, docs_path: Optional[str] = None):
        self.logger = logging.getLogger("DRX.AI.APIDatabase")
        self.docs_path = Path(docs_path) if docs_path else Path("./docs/api")
        
        self.entries: Dict[str, APIEntry] = {}
        
        if self.docs_path.exists():
            self._load_documentation()
    
    def _load_documentation(self):
        """
        Load API documentation from files
        """
        
        self.logger.info(f"Loading API docs from {self.docs_path}")
        
        for doc_file in self.docs_path.glob("**/*.json"):
            try:
                with open(doc_file, 'r') as f:
                    data = json.load(f)
                
                for entry_data in data.get("entries", []):
                    entry = APIEntry(**entry_data)
                    self.entries[entry.name] = entry
                    
            except Exception as e:
                self.logger.error(f"Failed to load {doc_file}: {e}")
        
        self.logger.info(f"Loaded {len(self.entries)} API entries")
    
    async def find_relevant(
        self,
        query: str,
        limit: int = 10
    ) -> List[Dict[str, Any]]:
        """
        Find API entries relevant to query
        
        Simple keyword matching for now.
        In production, use semantic search with embeddings.
        """
        
        query_lower = query.lower()
        keywords = query_lower.split()
        
        scored_entries = []
        
        for entry in self.entries.values():
            score = 0
            
            # Check name
            if any(kw in entry.name.lower() for kw in keywords):
                score += 3
            
            # Check description
            if any(kw in entry.description.lower() for kw in keywords):
                score += 2
            
            # Check category
            if any(kw in entry.category.lower() for kw in keywords):
                score += 1
            
            if score > 0:
                scored_entries.append((score, entry))
        
        # Sort by score
        scored_entries.sort(key=lambda x: x[0], reverse=True)
        
        # Return top results
        results = []
        for score, entry in scored_entries[:limit]:
            results.append({
                "name": entry.name,
                "namespace": entry.namespace,
                "description": entry.description,
                "usage": entry.usage,
                "example": entry.example,
                "category": entry.category,
                "relevance_score": score
            })
        
        return results
    
    def add_entry(self, entry: APIEntry):
        """
        Add new API entry
        """
        self.entries[entry.name] = entry
    
    def save_to_file(self, output_path: str):
        """
        Save database to JSON file
        """
        
        data = {
            "entries": [
                {
                    "name": e.name,
                    "namespace": e.namespace,
                    "description": e.description,
                    "usage": e.usage,
                    "parameters": e.parameters,
                    "return_type": e.return_type,
                    "example": e.example,
                    "category": e.category
                }
                for e in self.entries.values()
            ]
        }
        
        with open(output_path, 'w') as f:
            json.dump(data, f, indent=2)
