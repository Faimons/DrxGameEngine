#pragma once

#include "Core/Public/CoreTypes.h"
#include <cmath>

namespace DRX::Math {

struct Vector3 {
    float32 x, y, z;
    
    // Constructors
    Vector3() : x(0), y(0), z(0) {}
    Vector3(float32 x, float32 y, float32 z) : x(x), y(y), z(z) {}
    explicit Vector3(float32 scalar) : x(scalar), y(scalar), z(scalar) {}
    
    // Operators
    Vector3 operator+(const Vector3& other) const {
        return Vector3(x + other.x, y + other.y, z + other.z);
    }
    
    Vector3 operator-(const Vector3& other) const {
        return Vector3(x - other.x, y - other.y, z - other.z);
    }
    
    Vector3 operator*(float32 scalar) const {
        return Vector3(x * scalar, y * scalar, z * scalar);
    }
    
    Vector3 operator/(float32 scalar) const {
        return Vector3(x / scalar, y / scalar, z / scalar);
    }
    
    Vector3& operator+=(const Vector3& other) {
        x += other.x; y += other.y; z += other.z;
        return *this;
    }
    
    Vector3& operator-=(const Vector3& other) {
        x -= other.x; y -= other.y; z -= other.z;
        return *this;
    }
    
    Vector3& operator*=(float32 scalar) {
        x *= scalar; y *= scalar; z *= scalar;
        return *this;
    }
    
    // Static functions
    static float32 Dot(const Vector3& a, const Vector3& b) {
        return a.x * b.x + a.y * b.y + a.z * b.z;
    }
    
    static Vector3 Cross(const Vector3& a, const Vector3& b) {
        return Vector3(
            a.y * b.z - a.z * b.y,
            a.z * b.x - a.x * b.z,
            a.x * b.y - a.y * b.x
        );
    }
    
    // Instance methods
    float32 Length() const {
        return std::sqrt(x * x + y * y + z * z);
    }
    
    float32 LengthSquared() const {
        return x * x + y * y + z * z;
    }
    
    Vector3 Normalized() const {
        float32 len = Length();
        if (len > 0) {
            return *this / len;
        }
        return Vector3(0, 0, 0);
    }
    
    void Normalize() {
        float32 len = Length();
        if (len > 0) {
            *this /= len;
        }
    }
    
    // Static constants
    static const Vector3 Zero;
    static const Vector3 One;
    static const Vector3 Up;
    static const Vector3 Right;
    static const Vector3 Forward;
};

