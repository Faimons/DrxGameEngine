```python
"""
AI Code Generation Module
Generates C++/Python code from natural language
"""

import anthropic
import logging
from typing import Dict, Any, Optional
from dataclasses import dataclass


@dataclass
class CodeGenerationResult:
    success: bool
    code: str
    language: str
    iterations: int
    error: Optional[str] = None


class CodeGenerator:
    """
    Generates code using Claude API
    """
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.logger = logging.getLogger("DRX.AI.CodeGen")
        
        # Initialize Anthropic client
        api_key = config.get("anthropic_api_key")
        if not api_key:
            raise ValueError("Anthropic API key not provided")
        
        self.client = anthropic.Anthropic(api_key=api_key)
        
        self.model = config.get("model", "claude-sonnet-4-20250514")
        self.max_iterations = config.get("max_iterations", 3)
    
    async def generate(self, context: Dict[str, Any]) -> CodeGenerationResult:
        """
        Generate code from context
        
        Args:
            context: Full context including prompt, APIs, examples, etc.
        
        Returns:
            CodeGenerationResult
        """
        
        prompt = context.get("prompt", "")
        language = context.get("language", "cpp")
        
        self.logger.info(f"Generating {language} code")
        
        # Build comprehensive prompt
        full_prompt = self._build_prompt(context)
        
        # Generate with retries
        for iteration in range(self.max_iterations):
            try:
                self.logger.debug(f"Generation attempt {iteration + 1}")
                
                message = self.client.messages.create(
                    model=self.model,
                    max_tokens=4096,
                    temperature=0.3,  # Lower for code precision
                    messages=[
                        {
                            "role": "user",
                            "content": full_prompt
                        }
                    ]
                )
                
                # Extract code from response
                code = self._extract_code(message.content[0].text, language)
                
                if code:
                    return CodeGenerationResult(
                        success=True,
                        code=code,
                        language=language,
                        iterations=iteration + 1
                    )
                
            except Exception as e:
                self.logger.error(f"Generation failed: {e}")
                if iteration == self.max_iterations - 1:
                    return CodeGenerationResult(
                        success=False,
                        code="",
                        language=language,
                        iterations=iteration + 1,
                        error=str(e)
                    )
        
        return CodeGenerationResult(
            success=False,
            code="",
            language=language,
            iterations=self.max_iterations,
            error="Max iterations reached"
        )
    
    def _build_prompt(self, context: Dict[str, Any]) -> str:
        """
        Build comprehensive prompt for code generation
        """
        
        prompt_parts = []
        
        # System context
        prompt_parts.append("""You are an expert C++ game engine developer.
Generate high-quality, production-ready code following these guidelines:

REQUIREMENTS:
- C++17 standard
- Google C++ Style Guide
- RAII for resource management
- Smart pointers (no raw pointers)
- Const correctness
- Clear, self-documenting names
- Comprehensive error handling
- Performance-conscious

OUTPUT FORMAT:
- Return ONLY the code, no explanations
- Include necessary headers
- Add brief comments for complex logic
- Use proper namespacing
""")
        
        # User request
        prompt_parts.append(f"\nTASK:\n{context['prompt']}\n")
        
        # API documentation
        if context.get("relevant_apis"):
            prompt_parts.append("\nRELEVANT APIs:\n")
            for api in context["relevant_apis"]:
                prompt_parts.append(f"- {api['name']}: {api['description']}\n")
                prompt_parts.append(f"  Usage: {api['usage']}\n")
        
        # Examples
        if context.get("examples"):
            prompt_parts.append("\nEXAMPLES:\n")
            for ex in context["examples"][:2]:  # Limit to 2 examples
                prompt_parts.append(f"\n{ex['description']}:\n```cpp\n{ex['code']}\n```\n")
        
        # Constraints
        if context.get("constraints"):
            prompt_parts.append("\nCONSTRAINTS:\n")
            for key, value in context["constraints"].items():
                prompt_parts.append(f"- {key}: {value}\n")
        
        # Guidelines
        if context.get("coding_guidelines"):
            guidelines = context["coding_guidelines"]
            prompt_parts.append("\nCODING GUIDELINES:\n")
            for practice in guidelines.get("best_practices", []):
                prompt_parts.append(f"- {practice}\n")
        
        return "".join(prompt_parts)
    
    def _extract_code(self, response: str, language: str) -> Optional[str]:
        """
        Extract code from Claude's response
        """
        
        # Look for code blocks
        markers = {
            "cpp": ["```cpp", "```c++", "```"],
            "python": ["```python", "```py", "```"]
        }
        
        lang_markers = markers.get(language, ["```"])
        
        for marker in lang_markers:
            if marker in response:
                # Extract code between markers
                parts = response.split(marker)
                if len(parts) >= 2:
                    code = parts[1].split("```")[0].strip()
                    return code
        
        # If no code blocks, assume entire response is code
        return response.strip()
    
    async def generate_from_prompt(self, prompt: str) -> CodeGenerationResult:
        """
        Simple generation from just a prompt
        """
        
        context = {
            "prompt": prompt,
            "language": "cpp"
        }
        
        return await self.generate(context)
    
    async def fix_syntax(
        self,
        code: str,
        errors: list
    ) -> CodeGenerationResult:
        """
        Fix syntax errors in code
        """
        
        fix_prompt = f"""
Fix the syntax errors in this code:

```cpp
{code}
```

Errors:
{chr(10).join(f"- {err}" for err in errors)}

Return ONLY the corrected code.
"""
        
        return await self.generate_from_prompt(fix_prompt)
